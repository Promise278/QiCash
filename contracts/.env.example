# Copy to .env and fill in. NEVER commit .env — it holds private keys.
# Generate a deployer key whose EOA AND nonce-0 CREATE address are both
# 0x00-prefixed (Cyprus-1). The deploy script (scripts/deploy.js) checks this.

# Orchard testnet (chainId 15000) — recommended for development.
#   Faucet: https://orchard.faucet.quai.network
RPC_URL=https://orchard.rpc.quai.network/cyprus1
CHAIN_ID=15000

# Quai mainnet (chainId 9):
# RPC_URL=https://rpc.quai.network/cyprus1
# CHAIN_ID=9

# Deployer private key. Its address MUST begin with 0x00 — the first byte of a
# Quai address is the shard prefix, and 0x00 is Cyprus-1, the only active zone.
# The third hex character must also be 0-7: its high bit is the ledger flag, and
# a set bit means a Qi-ledger address, which cannot deploy contracts.
CYPRUS1_PK=

# Addresses granted roles at deploy time. All must be Quai-ledger, 0x00-prefixed.
# Leave blank to fall back to the deployer. All grants are signed by the admin,
# so if QICASH_ADMIN is a separate account, set QICASH_ADMIN_PK so the deploy
# script completes them; without it the script prints the calls to send manually.
QICASH_ADMIN=
QICASH_ADMIN_PK=
QICASH_VENDOR_MANAGER=
QICASH_ARBITER=
QICASH_PAUSER=

# Invoice lifetime in seconds (60 – 86400). 900 = 15 minutes.
QICASH_MAX_INVOICE_TTL=900

# Dispute window in seconds (3600 – 2592000). 604800 = 7 days.
QICASH_DISPUTE_WINDOW=604800

# Arbiter timeout in seconds (86400 – 7776000). 1209600 = 14 days.
QICASH_ARBITRATION_DEADLINE=1209600